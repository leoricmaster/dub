# ============================================================
# dub - environment configuration
# Copy to .env and fill in your keys
# ============================================================

# === DeepSeek (Translation) =================================
# Apply: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# === Aliyun DashScope (ASR) ================================
# Apply: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# === Aliyun OSS (audio upload for ASR) =====================
# Apply: https://oss.console.aliyun.com/
# Create a bucket in a region close to you, set read/write permission to Private.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_REGION=oss-cn-hangzhou
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# Object key prefix for temporary uploads (will be cleaned up after processing)
OSS_KEY_PREFIX=dub-cache/

# === MiniMax (TTS) =========================================
# Apply: https://platform.minimaxi.com/
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
